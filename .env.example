# Copy to .env and fill in. Defaults match docker-compose.yml.

# PostgreSQL (the API uses asyncpg; Alembic strips "+asyncpg" and uses psycopg2)
database_url=postgresql+asyncpg://postgres:my_secret_password@localhost:5432/docflow_db

# JWT signing. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ALGORITHM=HS256

# LLM provider (OpenAI-compatible). For OpenAI, use openai_base_url=https://api.openai.com
openai_api_key=sk-your-key-here
openai_model=deepseek-chat
openai_base_url=https://api.deepseek.com

# Redis: Celery broker, Bloom filter (needs RedisBloom, included in redis-stack), circuit breaker
redis_url=redis://localhost:6379/0
celery_task_default_queue=default

# S3-compatible storage (MinIO locally). The bucket is created on API startup if missing.
s3_endpoint_url=http://localhost:9000
s3_access_key_id=admin
s3_secret_access_key=my_super_secret_password
s3_region=us-east-1
s3_bucket_name=docflow
